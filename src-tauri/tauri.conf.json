{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ModelScout",
  "version": "0.1.1",
  "identifier": "com.huaxidesu.modelscout",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ModelScout — 大模型 API 探测器",
        "width": 1360,
        "height": 880,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "transparent": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/model_params.json"],
    "copyright": "Copyright (c) 2026 Huaxidesu. PolyForm Noncommercial 1.0.0 (Noncommercial use only).",
    "license": "PolyForm-Noncommercial-1.0.0",
    "licenseFile": "../LICENSE",
    "category": "DeveloperTool",
    "shortDescription": "大模型 API 探测与配置生成工具",
    "longDescription": "ModelScout 自动探测任意 OpenAI 兼容 API 端点上全部可用模型的工具调用、附件上传、推理能力与上下文窗口上限，并一键生成 OpenCode / DeepSeekHardness 配置文件。",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  },
  "plugins": {}
}
